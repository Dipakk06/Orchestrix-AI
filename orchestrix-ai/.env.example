# Backend
APP_NAME=Orchestrix AI API
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
JWT_SECRET=replace_with_secure_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/orchestrix
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=orchestrix_memory
WHISPER_MODEL=base
TTS_ENGINE=pyttsx3

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
